APP_NAME="Production Perplexity API"
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=mysql+asyncmy://perplexity:perplexity_dev_pass@localhost:3306/perplexity_dev
TEST_DATABASE_URL=mysql+asyncmy://perplexity:perplexity_dev_pass@localhost:3306/perplexity_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false
